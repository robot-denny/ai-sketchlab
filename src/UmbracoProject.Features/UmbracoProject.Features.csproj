<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- NU1902: AngleSharp 1.4.0 (GHSA-pgww-w46g-26qg, moderate — affects "(, 1.5.0)"), transitive
         via Umbraco.AI.Search 17.0.0 → Umbraco.AI.Core 17.0.0 → SmartReader 0.11.0 → AngleSharp.
         STILL LIVE for this project only: the host resolves AngleSharp 1.5.2 (its Umbraco.AI 17.3.1
         pulls SmartReader 0.11.1), so the deployed app is unaffected — this is a graph-local
         exposure of the RCL when resolved standalone. It clears when AI.Search moves to 17.0.1+
         (which widens Cms.Search.Core to the 17.x line and floats AI.Core to 17.3.x) — tracked as
         `deps-ai-search-version-realignment` in ROADMAP, Tier 2, needs runtime verification.
         NU1903 was REMOVED on 2026-08-26: the Lucene.Net.Replicator advisory it named
         (GHSA-2qw8-ppr5-m96c) affects [4.8.0-beta00005, 4.8.0-beta00017) and the resolved
         beta00017 is outside that range, so it suppressed nothing. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- jcdcdev.Umbraco.ExtendedMarkdownEditor: required because a generated PublishedModel
         (Documentation.MarkdownContent) is strongly typed to its MarkdownValue. Pinned to the
         host's version — Cloud's CI/CD Flow validator rejects Version="*". -->
    <PackageReference Include="jcdcdev.Umbraco.ExtendedMarkdownEditor" Version="17.0.5" />
    <!-- MessagePack: direct pin to float the transitive (Umbraco.Cms.Search.Core 1.0.0 → MessagePack
         [3.1.4,)) up to the first patched release. 3.1.4–3.1.6 carry GHSA-hv8m-jj95-wg3x (high, NU1903)
         plus the moderate NU1902 advisories; 3.1.7 was the first patched release; pinned forward to 3.1.8, then to 3.1.9 for GHSA-qhrr-8q5h-9q3h (moderate, NU1902, affects >= 3.0.0, < 3.1.9; 2026-10-15). The open dependency range lets us pin
         forward without breaking the chain — so we resolve the vulnerability rather than suppress it.
         Mirrors the host's pin. Revisit when Umbraco's Search chain ships a newer MessagePack itself. -->
    <PackageReference Include="MessagePack" Version="3.1.9" />
    <!-- System.Security.Cryptography.Pkcs / .Xml: direct pins to float the transitive 10.0.10 past the
         2026-10-13 advisories affecting >= 10.0.0, <= 10.0.12 — Pkcs GHSA-846f-f764-76mx (high) +
         GHSA-2fmv-rv2c-59x7 (moderate); Xml GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83
         (high). 10.0.13 is the first patched release. This RCL is a library, so neither package is pruned
         to the shared framework. Mirrors HelloWorld's pins; drop once Umbraco's chain floats them. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Umbraco.AI.Search 17.0.0 constrains Umbraco.Cms.Search.Core to [1.0.0, 1.999.999),
         so Core stays on the 1.x line (mirrors the host). -->
    <PackageReference Include="Umbraco.AI.Search" Version="17.0.0" />
    <PackageReference Include="Umbraco.Cms" Version="17.6.2" />
    <PackageReference Include="Umbraco.Cms.Search.Core" Version="1.0.0" />
  </ItemGroup>

  <!-- SixLabors.ImageSharp 3.1.12 advisories (published 2026-10-07), NAMED suppressions, not a blanket
       NU1902/NU1903 NoWarn. The only patched release is 4.1.2, a new major that Umbraco's imaging stack
       (Umbraco.Cms.Imaging.ImageSharp → ImageSharp 3.1.12 + ImageSharp.Web 3.2.0, unchanged through
       Umbraco 18.2.1) was not built against, so pinning it risks runtime breakage in media cropping/resizing.
       Exposure is limited: uploads are backoffice-only (authenticated editors). Covered paths:
         GHSA-j3p4-wp97-rph4 (high)   HistogramEqualization unchecked index — processor not used by Umbraco crops
         GHSA-j9gm-c75j-xc9q (high)   TIFF CCITT T4 encoder overflow — encode path
         GHSA-jjfr-hcj7-qf5w (high)   TIFF CCITT T6 encoder overflow — encode path
         GHSA-gwg2-r3hj-4w44 (medium) ICC CLUT parsing unbounded allocation — decode path
         GHSA-wmxv-xphr-5c9g (medium) BigTIFF IFD count non-progressing loop — decode path
       Remove these once Umbraco ships an ImageSharp >= 4.1.2 (tracked in ROADMAP deps-imagesharp-advisories).
       Any NEW advisory still fails the build. Mirrored in UmbracoProject, UmbracoProject.Features and
       UmbracoProject.Tests — keep the three lists identical. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

</Project>
