<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- jcdcdev.Umbraco.ExtendedMarkdownEditor: required because a generated PublishedModel
         (Documentation.MarkdownContent) is strongly typed to its MarkdownValue. Pinned to the
         host's version — Cloud's CI/CD Flow validator rejects Version="*". -->
    <PackageReference Include="jcdcdev.Umbraco.ExtendedMarkdownEditor" Version="18.0.0" />
    <!-- System.Security.Cryptography.Pkcs / .Xml: direct pins to float the transitive 10.0.10 past the
         2026-10-13 advisories affecting >= 10.0.0, <= 10.0.12 — Pkcs GHSA-846f-f764-76mx (high) +
         GHSA-2fmv-rv2c-59x7 (moderate); Xml GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83
         (high). 10.0.13 is the first patched release. This RCL is a library, so neither package is pruned
         to the shared framework. Mirrors HelloWorld's pins; drop once Umbraco's chain floats them. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Umbraco.AI.Search 18.0.7 constrains Umbraco.Cms.Search.Core to [18.0.0, 18.999.999),
         so Core is on the 18.x line (mirrors the host). -->
    <PackageReference Include="Umbraco.AI.Search" Version="18.0.7" />
    <PackageReference Include="Umbraco.Cms" Version="18.3.2" />
    <PackageReference Include="Umbraco.Cms.Search.Core" Version="18.2.0" />
  </ItemGroup>

  <!-- SixLabors.ImageSharp 3.1.12 advisories (published 2026-10-07), NAMED suppressions, not a blanket
       NU1902/NU1903 NoWarn. 4.1.2 patches all six but is a new major that Umbraco's imaging stack
       (Umbraco.Cms.Imaging.ImageSharp → ImageSharp 3.1.12 + ImageSharp.Web 3.2.0, unchanged through
       Umbraco 18.2.2) was not built against, so pinning it risks runtime breakage in media cropping/resizing.
       3.2.0 (same major) also patches all six, but it adds Six Labors license enforcement: without a
       paid SixLaborsLicenseKey a Release build fails (Debug only warns), which breaks Cloud's publish.
       Exposure is limited: uploads are backoffice-only (authenticated editors). Covered paths:
         GHSA-v76p-62qx-wwq2 (high)   Tiled fax TIFF heap OOB write — decode path
         GHSA-j3p4-wp97-rph4 (high)   HistogramEqualization unchecked index — processor not used by Umbraco crops
         GHSA-j9gm-c75j-xc9q (high)   TIFF CCITT T4 encoder overflow — encode path
         GHSA-jjfr-hcj7-qf5w (high)   TIFF CCITT T6 encoder overflow — encode path
         GHSA-gwg2-r3hj-4w44 (medium) ICC CLUT parsing unbounded allocation — decode path
         GHSA-wmxv-xphr-5c9g (medium) BigTIFF IFD count non-progressing loop — decode path
       Remove these once Umbraco ships a patched ImageSharp (3.2.0+ or 4.1.2+; tracked in ROADMAP
       deps-imagesharp-advisories).
       Any NEW advisory still fails the build. Mirrored in UmbracoProject, UmbracoProject.Features and
       UmbracoProject.Tests — keep the three lists identical. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

</Project>
