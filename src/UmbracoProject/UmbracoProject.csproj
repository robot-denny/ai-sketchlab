<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS0618 is NOT suppressed here: obsolete-API ("deprecated for v18") usage is now gated
         at build time. With build-time Razor compilation on (arch-modelsbuilder-source-mode),
         every CS0618 site in a .cshtml is enumerated by `dotnet build`, and any obsolete usage
         fails the build. No call sites are grandfathered (the former per-call-site pragmas were
         removed in the Umbraco 18 upgrade, Phase A). If one is ever unavoidable, use a scoped
         `#pragma warning disable/restore CS0618` at the call site, not a project-wide <NoWarn>:
         Cloud's runtime Razor compiler honors TWAE but does NOT read the csproj <NoWarn> list.
         CS8600/CS8602/CS8603/CS8604: nullable-reference-type warnings. Enabling build-time Razor
         compilation (arch-modelsbuilder-source-mode) made the compiler check ~102 pre-existing
         nullable sites across 22 views — idiomatic Umbraco template code (`.Url()`, `.Children<T>()`,
         etc.) that was never nullable-checked under the old runtime-compile model and runs fine.
         Grandfathered project-wide so the build-time obsolete-API gate can land without churn;
         the host's hand-written C# that most benefits from nullable strictness is migrating into
         the UmbracoProject.Features RCL (which keeps <Nullable>enable</Nullable>), so the lasting
         gap is only Program.cs + a few Helpers. Tracked for incremental cleanup in ROADMAP
         (`arch-view-nullable-hardening`); remove these once views carry explicit null handling.
         NU1902/NU1903 were REMOVED on 2026-08-26 (Umbraco.Cms 17.5.3 → 17.6.2): both advisories
         they named are now patched, per NuGet's vulnerability feed — Lucene.Net.Replicator
         GHSA-2qw8-ppr5-m96c affects [4.8.0-beta00005, 4.8.0-beta00017) and the resolved
         beta00017 sits outside it; AngleSharp GHSA-pgww-w46g-26qg affects (, 1.5.0) and the
         17.6.2 chain floats AngleSharp to 1.5.2. The vulnerable/include-transitive scan is clean for
         this project, so the suppressions were masking nothing and would have hidden any NEW
         NU1902/NU1903 advisory. Do not re-add them without a live advisory to name. -->
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604</NoWarn>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <!-- ErrorOnDuplicatePublishOutputFiles=false: Umbraco.Cms.Targets' `CopyUmbracoJsonSchemaFiles`
         target runs unconditionally in EVERY project that references Umbraco.Cms, so both this host
         AND the UmbracoProject.Features RCL emit identically-named IDE-assist schema files
         (appsettings-schema.json, appsettings-schema.Umbraco.Cms.json, umbraco-package-schema.json).
         They build fine, but collide at the same relative path during `dotnet publish` → NETSDK1152,
         which `dotnet build` never surfaces (so it passed Gate 1 + the pre-push hook) but fails the
         Cloud Kudu `deploy.cmd` publish on a Portal Dev→Live promotion (Run 50, 2026-06-29). The
         target has no opt-out property; these schema files are dev-only IDE assist with no runtime
         effect, so letting the publish dedupe them (host copy wins) is safe. ALWAYS run
         `dotnet publish -c Release` — not just `dotnet build` — when verifying RCL-split changes. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clean.Core" Version="8.0.1" />
    <PackageReference Include="jcdcdev.Umbraco.ExtendedMarkdownEditor" Version="18.0.0" />
    <!-- MessagePack: direct pin to float the transitive MessagePack past its advisories. On v18,
         Umbraco.Cms 18.2.1 asks for MessagePack >= 3.1.8 and Umbraco.Cms.Search.Core 18.2.0 for >= 3.1.7,
         so NuGet would resolve 3.1.8, which carries GHSA-qhrr-8q5h-9q3h (moderate, NU1902, affects
         >= 3.0.0, < 3.1.9; 2026-10-15). 3.1.9 is the first patched release. Both floors are open ranges,
         so pinning forward doesn't break the chain: we resolve the vulnerability rather than suppress it.
         (History: first pinned on v17 to 3.1.7+ for GHSA-hv8m-jj95-wg3x, high, NU1903.) Drop once
         Umbraco's chain asks for MessagePack >= 3.1.9 itself. -->
    <PackageReference Include="MessagePack" Version="3.1.9" />
    <!-- System.Security.Cryptography.Pkcs: direct pin to float the transitive 10.0.0 past
         GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate), both affecting >= 10.0.0, <= 10.0.12
         (2026-10-13); 10.0.13 is the first patched release. Unlike Cryptography.Xml (below), Pkcs is not
         pruned to the shared framework here, so the host needs its own pin. Drop once Umbraco's chain
         floats to a patched Pkcs itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- NB: System.Security.Cryptography.Xml (GHSA-23rf-6693-g89p et al.) is deliberately NOT pinned
         here — the host is an executable, so .NET 10 prunes that package to the shared-framework copy
         (an explicit pin trips NU1510). The advisory only bites HelloWorld, a packable RCL that doesn't
         prune it; the pin lives there. -->

    <!-- Umbraco.AI suite on the v18 line (Umbraco 18 upgrade, 2026-10-22). The vendor patches each
         package independently, hence the mixed 18.x minors below. The minimums are interlocked, so
         move the family as ONE unit: the provider packages (OpenAI/Anthropic/Google) require
         AI.Core >= 18.6.0; AI.Agent.Deploy 18.1.0 requires AI.Agent.Startup >= 18.4.0 and
         AI.Deploy >= 18.3.0; AI.Search.Core 18.0.4 requires Umbraco.Cms.Search.Core [18.0.0, 18.999.999).
         (AI.Core and AI.Startup are internal components pulled transitively by the Umbraco.AI
         metapackage — they are not separate PackageReference lines; only Umbraco.AI is.) -->
    <PackageReference Include="Umbraco.AI" Version="18.6.0" />
    <PackageReference Include="Umbraco.AI.Agent" Version="18.4.0" />
    <PackageReference Include="Umbraco.AI.Agent.Copilot" Version="18.2.0" />
    <PackageReference Include="Umbraco.AI.Agent.Deploy" Version="18.1.0" />
    <PackageReference Include="Umbraco.AI.Agent.UI" Version="18.3.0" />
    <PackageReference Include="Umbraco.AI.AGUI" Version="18.4.0" />
    <PackageReference Include="Umbraco.AI.Anthropic" Version="18.1.3" />
    <PackageReference Include="Umbraco.AI.Deploy" Version="18.3.0" />
    <PackageReference Include="Umbraco.AI.Google" Version="18.0.4" />
    <PackageReference Include="Umbraco.AI.OpenAI" Version="18.3.1" />
    <PackageReference Include="Umbraco.AI.Prompt" Version="18.4.0" />
    <PackageReference Include="Umbraco.AI.Prompt.Deploy" Version="18.0.4" />
    <PackageReference Include="Umbraco.AI.Search" Version="18.0.4" />
    <PackageReference Include="Umbraco.Cloud.Cms" Version="18.0.3" />
    <PackageReference Include="Umbraco.Cloud.StorageProviders.AzureBlob" Version="18.0.0" />
    <PackageReference Include="Umbraco.Cms" Version="18.2.1" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="18.2.1" />
    <!-- Umbraco.Cms.Search.* on the CMS-aligned 18.x line, matching Umbraco.AI.Search 18.0.4's
         [18.0.0, 18.999.999) constraint on Cms.Search.Core. Provider.Examine 18.2.0 is a stable
         release, which retires the old 1.0.0-beta.9 pin (docs/pinned-betas.md). -->
    <PackageReference Include="Umbraco.Cms.Search.BackOffice" Version="18.2.0" />
    <PackageReference Include="Umbraco.Cms.Search.Core" Version="18.2.0" />
    <PackageReference Include="Umbraco.Cms.Search.DeliveryApi" Version="18.2.0" />
    <PackageReference Include="Umbraco.Cms.Search.Provider.Examine" Version="18.2.0" />
    <PackageReference Include="Umbraco.Deploy.Cloud" Version="18.1.1" />
    <PackageReference Include="Umbraco.Forms" Version="18.2.1" />
    <PackageReference Include="Umbraco.Forms.Deploy" Version="18.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HelloWorld/HelloWorld.csproj" />
    <ProjectReference Include="../UmbracoProject.Features/UmbracoProject.Features.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <!-- SixLabors.ImageSharp 3.1.12 advisories (published 2026-10-07), NAMED suppressions, not a blanket
       NU1902/NU1903 NoWarn. The only patched release is 4.1.2, a new major that Umbraco's imaging stack
       (Umbraco.Cms.Imaging.ImageSharp → ImageSharp 3.1.12 + ImageSharp.Web 3.2.0, unchanged through
       Umbraco 18.2.1) was not built against, so pinning it risks runtime breakage in media cropping/resizing.
       Exposure is limited: uploads are backoffice-only (authenticated editors). Covered paths:
         GHSA-j3p4-wp97-rph4 (high)   HistogramEqualization unchecked index — processor not used by Umbraco crops
         GHSA-j9gm-c75j-xc9q (high)   TIFF CCITT T4 encoder overflow — encode path
         GHSA-jjfr-hcj7-qf5w (high)   TIFF CCITT T6 encoder overflow — encode path
         GHSA-gwg2-r3hj-4w44 (medium) ICC CLUT parsing unbounded allocation — decode path
         GHSA-wmxv-xphr-5c9g (medium) BigTIFF IFD count non-progressing loop — decode path
       Remove these once Umbraco ships an ImageSharp >= 4.1.2 (tracked in ROADMAP deps-imagesharp-advisories).
       Any NEW advisory still fails the build. Mirrored in UmbracoProject, UmbracoProject.Features and
       UmbracoProject.Tests — keep the three lists identical. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

</Project>
