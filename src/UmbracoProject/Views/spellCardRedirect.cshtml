@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using UmbracoProject.Features.Services.Content
@inject IUrlSegmentReader UrlSegments

@*
    Spell Card Redirect — the template on a stack node and on both card types.

    WHY IT EXISTS. Cards stay in site search on purpose (SearchService filters by
    document-type alias only), so a card WILL come back as a result. A node with no
    template 404s, which would make every one of those results a dead link. This
    sends a direct hit to the card's place in the deck instead, and gives each card
    a real shareable URL.

    The deep link is the same hash the deck's JavaScript reads in Step 8:
        <spellbook url>#deck/<stack-slug>          (a stack node)
        <spellbook url>#deck/<stack-slug>/<card-slug>   (a card node)

    302, not 301: a permanent redirect is cached hard by browsers, and where a card
    lives is a content decision an editor may still move.

    If Umbraco 18 Elements ever take this content out of the tree, this template is
    the first thing that gets deleted.
*@

@{
    Layout = null;

    var isStack = string.Equals(Model.ContentType.Alias, "spellCardStack", StringComparison.Ordinal);
    var stack = isStack ? Model : Model.Parent();
    var spellbook = Model.AncestorOrSelf("spellbook");

    // IPublishedContent.UrlSegment is obsolete in v18; IUrlSegmentReader resolves it the
    // same way and returns "" (never null) when there is no segment.
    var stackSegment = stack == null ? string.Empty : UrlSegments.GetUrlSegment(stack);

    string target;
    if (spellbook == null)
    {
        // Nothing to deep-link into — send the visitor somewhere real rather than
        // leaving them on a blank body.
        target = "/";
    }
    else if (string.IsNullOrWhiteSpace(stackSegment))
    {
        target = spellbook.Url();
    }
    else if (isStack)
    {
        target = spellbook.Url() + "#deck/" + stackSegment;
    }
    else
    {
        target = spellbook.Url() + "#deck/" + stackSegment + "/" + UrlSegments.GetUrlSegment(Model);
    }

    Context.Response.Redirect(target, permanent: false);
}
