          "DataType": "umb://data-type/0cc0eba1996042c9bf9b60e150b429ae",
          "ValueType": "System.String",
          "Description": "The pack identity key. Shipped keys: core, umbraco-17, umbraco-cloud, dotnet. Lowercase letters, numbers and hyphens only. An unknown key falls back to the neutral accent and the monogram.",
          "Name": "Pack Key",
          "SortOrder": 30,
          "Validation": "^[a-z0-9-]\u002B$",
          "ValidationMessage": "Lowercase letters, numbers and hyphens only - no spaces, capitals or dots. Shipped keys: core, umbraco-17, umbraco-cloud, dotnet."
        }
      ]
